# Configurações de Ambiente para Psiu
# Copie este arquivo para .env e configure os valores apropriados

# ================================================
# 🔧 CONFIGURAÇÃO BASE
# ================================================

# Ambiente: "development" (local) ou "production" (servidor)
ENVIRONMENT=development

# ================================================
# 🔒 SEGURANÇA
# ================================================

# Chave secreta do Django (gere uma nova para produção)
SECRET_KEY=dev-secret-key-change-in-production

# Modo debug (True para desenvolvimento, False para produção)
DEBUG=True

# Hosts permitidos (separe por vírgula)
ALLOWED_HOSTS=localhost:8000,127.0.0.1:8000

# ================================================
# 🧱 BANCO DE DADOS
# ================================================

# URL do banco de dados
# SQLite (desenvolvimento): sqlite:///db.sqlite3
# PostgreSQL (produção): postgres://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=sqlite:///db.sqlite3

# ================================================
# 📧 CONFIGURAÇÃO DE EMAIL
# ================================================

# Backend de email
# Console (desenvolvimento): django.core.mail.backends.console.EmailBackend
# SMTP (produção): django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Configurações SMTP (para produção)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-app

# ================================================
# 📁 ARQUIVOS ESTÁTICOS E MÍDIA (PRODUÇÃO)
# ================================================

# Caminhos para produção (PythonAnywhere, etc.)
STATIC_ROOT=/home/seu-usuario/clone-x/staticfiles
MEDIA_ROOT=/home/seu-usuario/clone-x/media

# ================================================
# 🔧 CONFIGURAÇÕES ADICIONAIS
# ================================================

# Idioma e fuso horário
LANGUAGE_CODE=pt-br
TIME_ZONE=America/Recife

# ================================================
# 📝 INSTRUÇÕES
# ================================================
# 1. Copie este arquivo: cp .env.example .env
# 2. Edite o arquivo .env com suas configurações
# 3. Nunca commite o arquivo .env no Git (já está no .gitignore)
# 4. Para produção, gere uma SECRET_KEY segura e configure o banco PostgreSQL
